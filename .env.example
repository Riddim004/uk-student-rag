# --- Product mode -------------------------------------------------------
# Without a key the app runs in extractive demo mode: retrieval + gate are
# real, answers are verbatim quotes. With a key, answers are composed by the
# chat model and still checked against the same citations.
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.deepseek.com/v1

# --- Models -------------------------------------------------------------
# local | openai | hashing  (hashing is for tests, not quality)
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=400
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Retrieval ----------------------------------------------------------
CHUNK_SIZE=260
CHUNK_OVERLAP=40
TOP_K=5
CANDIDATE_K=50
RRF_K=60
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATE_K=15
MIN_RERANK_SCORE=-3.0
MIN_DENSE_SCORE=0.30
MIN_SPARSE_SCORE=0.0

# --- Reliability --------------------------------------------------------
REQUEST_TIMEOUT_S=30
MAX_RETRIES=2
RETRY_BASE_DELAY_S=0.5
FALLBACK_TO_EXTRACTIVE=true
REFUSE_WHEN_EMPTY=true
